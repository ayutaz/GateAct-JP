# GateAct-JP firmware for ESP32-S3.
# CPU / cache / console は JapaneseTinyAgentLM firmware(M5Stack CoreS3)と同じにして、
# 同一ボードでの速度比較の条件をそろえる。
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# コンソール: ネイティブ USB-Serial/JTAG(CoreS3 / XIAO 等)。UART の開発ボードでは
# idf.py menuconfig で CONFIG_ESP_CONSOLE_UART_DEFAULT に変える。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# PSRAM はあれば検出して報告する(モデルは内部 RAM だけで動く)。無いボードでも起動する。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

CONFIG_ESP_TASK_WDT_EN=n
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
